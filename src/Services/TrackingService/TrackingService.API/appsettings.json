{
  "ConnectionStrings": {
    "Redis": "localhost:6379,password=YOUR_REDIS_PASSWORD"
  },
  "JwtSettings": {
    "Secret": "YOUR_SECRET_JWT_KEY",
    "Issuer": "SmartFreightLogistics.Identity",
    "Audience": "SmartFreightLogistics.Gateways",
    "ExpiryInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Observability": {
    "ServiceName": "TrackingService",
    "EnablePrometheus": true
  },
  "AllowedHosts": "*"
}
